# Copy this file to .env and fill in real values.
# .env itself is already gitignored -- never commit real keys.

# --- Required to run the real (non-mock) pipeline end to end ---

# research stage (perplexity/sonar-deep-research). Only actually called for
# a scene that requires historical grounding (docs/decisions/0035, 0036);
# a typical horror scene skips it.
PERPLEXITY_API_KEY=

# fact_check stage and previz stage (gemini/gemini-2.5-flash-image).
# See docs/decisions/0011 for why previz moved onto this key -- note that
# 0011's reasoning no longer applies (docs/decisions/0038), so this stage's
# model is an open choice again rather than a fixed one.
GEMINI_API_KEY=

# video_generation stage -- Wan 2.2 hosted on Replicate, called directly
# rather than through litellm (docs/decisions/0037, 0038).
REPLICATE_API_TOKEN=

# previz_review stage (anthropic/claude-sonnet-5) -- independently checks
# previz's generated image, not just its prompt. See decisions/0009.
ANTHROPIC_API_KEY=

# --- Optional ---

# moderation_check only. This is now the single remaining use of an OpenAI
# key in the project: the free omni-moderation-latest endpoint, run as an
# advisory YouTube-policy signal before video generation
# (docs/decisions/0038). Nothing blocks if it's absent -- but the check
# will raise if it's called without one, so leave it set or expect to skip
# --video-gen-from's pre-flight.
OPENAI_API_KEY=

# Required if a stage in config/models.yaml is switched to a deepseek/...
# model -- scene_planning currently is, and --experiment-model commonly is.
DEEPSEEK_API_KEY=
