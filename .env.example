# Copy this file to .env and fill in real values.
# .env itself is already gitignored -- never commit real keys.

# --- Required to run the real (non-mock) pipeline end to end ---

# scene_planning (deepseek/deepseek-v4-flash). Planning is the pipeline's
# first stage now -- research and fact-check ran in front of it until
# docs/decisions/0069 deleted them.
DEEPSEEK_API_KEY=

# previz (gemini/gemini-2.5-flash-image) -- every beat image.
# See docs/decisions/0011 for why previz moved onto this key; note that
# 0011's reasoning no longer applies (docs/decisions/0038), so this
# stage's model is an open choice again rather than a fixed one.
GEMINI_API_KEY=

# video_generation -- Wan 2.2 hosted on Replicate, called directly rather
# than through litellm (docs/decisions/0037, 0038).
REPLICATE_API_TOKEN=

# --- Optional ---

# moderation_check only: the free omni-moderation-latest endpoint, run as
# an advisory YouTube-policy signal before video generation
# (docs/decisions/0038). Nothing blocks if it's absent -- but the check
# raises if called without one, so leave it set or expect to skip
# --video-gen-from's pre-flight.
OPENAI_API_KEY=

# previz_review (anthropic/claude-sonnet-5). NOT used by the pipeline:
# docs/decisions/0055 deleted that reviewer after measuring 56% agreement
# with the owner against 79% for accepting everything. Needed only to run
# the eval scripts that still call it.
ANTHROPIC_API_KEY=

# PERPLEXITY_API_KEY used to live here for the research stage. That stage
# is deleted (docs/decisions/0069) and nothing in this project calls
# Perplexity any more -- safe to remove from a local .env.

# Kling's developer API (kling.ai/dev) -- prepaid, and separate from any
# consumer Kling subscription. Only needed for the "kling" video backend.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Alibaba Cloud Model Studio, for the "wan" video backend reached directly
# rather than through Replicate. Not the same as REPLICATE_API_TOKEN.
DASHSCOPE_API_KEY=
