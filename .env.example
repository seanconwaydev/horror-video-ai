# Copy this file to .env and fill in real values.
# .env itself is already gitignored -- never commit real keys.

# v1 stages (docs/decisions/0007-research-fact-check-previz-models.md,
# 0009-previz-image-review.md, 0010-video-generation-model-and-standalone-
# stage.md, 0011-previz-image-model-for-video-aspect-ratio-fit.md) -- all
# five are required to run the real (non-mock) pipeline end to end.

# research stage (perplexity/sonar-deep-research).
PERPLEXITY_API_KEY=

# fact_check stage (gemini/gemini-2.5-flash with search grounding) and
# previz stage (gemini/gemini-2.5-flash-image). See decisions/0011 for why
# previz moved onto this key from OpenAI.
GEMINI_API_KEY=

# video_generation stage (openai/sora-2). Previously previz's key before
# decisions/0011 moved previz onto Gemini.
OPENAI_API_KEY=

# previz_review stage (anthropic/claude-sonnet-5) -- independently checks
# previz's generated image, not just its prompt. See decisions/0009.
ANTHROPIC_API_KEY=

# Deferred stages -- not used by any v1 code path yet (config/models.yaml's
# narrative/narrative_review/shot_list/video_prompts entries are still the
# anthropic/claude-sonnet-5 scaffolding placeholder). Not required to run
# the pipeline today; keep here for when those stages are built.

# Required if a deferred stage in config/models.yaml is switched to a
# deepseek/... model.
DEEPSEEK_API_KEY=
