# Copy this file to .env and fill in real values.
# .env itself is already gitignored -- never commit real keys.

# v1 stages (docs/decisions/0007-research-fact-check-previz-models.md) --
# all three are required to run the real (non-mock) pipeline end to end.

# research stage (perplexity/sonar-deep-research).
PERPLEXITY_API_KEY=

# fact_check stage (gemini/gemini-2.5-flash with search grounding).
GEMINI_API_KEY=

# previz stage (openai/gpt-image-1-mini).
OPENAI_API_KEY=

# Deferred stages -- not used by any v1 code path yet (config/models.yaml's
# narrative/narrative_review/shot_list/video_prompts entries are still the
# anthropic/claude-sonnet-5 scaffolding placeholder). Not required to run
# the pipeline today; keep here for when those stages are built.

# Required if a deferred stage in config/models.yaml uses an anthropic/...
# model.
ANTHROPIC_API_KEY=

# Required if a deferred stage in config/models.yaml is switched to a
# deepseek/... model.
DEEPSEEK_API_KEY=
